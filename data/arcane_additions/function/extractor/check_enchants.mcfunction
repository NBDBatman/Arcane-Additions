# Generated block: one entry per known enchantment ID (43 vanilla + this
# pack's own). Runs "as and at" the source item (see begin_extraction.mcfunction).
# For each enchantment the item actually has, spawns a floating enchanted-book
# choice carrying that exact enchant + level, and records it as queued so
# watch_choices.mcfunction knows to wait for it.

execute if data entity @s Item.components."minecraft:enchantments".levels."minecraft:aqua_affinity" run summon minecraft:item ~ ~0.4 ~ {Item:{id:"minecraft:enchanted_book",count:1,components:{"minecraft:stored_enchantments":{levels:{}}}},Tags:["arcane_additions.extract_choice","arcane_additions.enchant.minecraft.aqua_affinity"],PickupDelay:20s,NoGravity:0b,Motion:[0.0d,0.3d,0.0d]}
execute if data entity @s Item.components."minecraft:enchantments".levels."minecraft:aqua_affinity" run data modify entity @e[tag=arcane_additions.extract_choice,tag=arcane_additions.enchant.minecraft.aqua_affinity,limit=1,sort=nearest,distance=..2] Item.components."minecraft:stored_enchantments".levels."minecraft:aqua_affinity" set from entity @s Item.components."minecraft:enchantments".levels."minecraft:aqua_affinity"
execute if data entity @s Item.components."minecraft:enchantments".levels."minecraft:aqua_affinity" run data modify storage arcane_additions:extractor session.queued.minecraft.aqua_affinity set value 1b

